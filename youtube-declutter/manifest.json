{
  "manifest_version": 3,
  "name": "YouTube Declutter",
  "description": "Hide distracting parts of YouTube: comments, Shorts, ads, end screens, merch shelves, AI clutter and more.",
  "version": "10.2",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://music.youtube.com/*"],
      "js": ["features.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Declutter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
