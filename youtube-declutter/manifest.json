{
  "manifest_version": 3,
  "name": "YouTube Declutter",
  "description": "Hide distracting parts of YouTube: comments, Shorts, ads, end screens, merch shelves, AI clutter and more.",
  "version": "10.0",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["features.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Declutter"
  }
}
